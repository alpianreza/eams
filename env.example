#--------------------------------------------------------------------
# CONTOH KONFIGURASI ENVIRONMENT
#--------------------------------------------------------------------
# Salin file ini menjadi `.env` lalu isi nilainya sesuai server.
# JANGAN pernah commit file `.env` ke Git.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/'
app.publicURL = 'https://example.com/'
app.forceGlobalSecureRequests = false
app.indexPage = ''
app.uriProtocol = 'REQUEST_URI'
app.debugToolbar = false

# Trust proxy (isi IP proxy/NAT, hindari '*' bila memungkinkan)
app.proxyIPs = ''

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = asset_compliance_system
database.default.username = ISI_USERNAME_DB
database.default.password = ISI_PASSWORD_DB
database.default.DBDriver = MySQLi

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate dengan: php spark key:generate
encryption.key =

#--------------------------------------------------------------------
# WhatsApp Weekly Reminder
#--------------------------------------------------------------------
whatsapp.enabled = false
whatsapp.provider = fonnte
whatsapp.fonnteEndpoint = https://api.fonnte.com/send
whatsapp.fonnteToken = ISI_TOKEN_FONNTE
whatsapp.timeout = 20

# Fallback mapping nama ke nomor WA
# Format: NAMA:62812...,NAMA LAIN:62813...
whatsapp.namePhoneMap =

#--------------------------------------------------------------------
# EAMS Agent Runtime
#--------------------------------------------------------------------
agent.defaultHeartbeatInterval = 86400
agent.remoteHeartbeatInterval = 86400
agent.commandPollInterval = 5
agent.commandPollThrottleSeconds = 5
agent.pushPort = 8765
agent.pushTimeout = 2
