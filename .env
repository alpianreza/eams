
# logger.threshold = 4
CI_ENVIRONMENT = production

app.baseURL = 'http://192.168.1.14/'
app.forceGlobalSecureRequests = false
app.publicURL = https://eams.ptyhs.com/

app.indexPage = ''
app.uriProtocol = 'REQUEST_URI'

# TRUST PROXY (WAJIB KARENA LEWAT NAT)
app.proxyIPs = '*'
app.debugToolbar = false

database.default.hostname = localhost
database.default.database = asset_compliance_system
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi

# ==============================
# WhatsApp Weekly Reminder
# ==============================
# Set true jika sudah siap kirim WA
whatsapp.enabled = true

# Provider saat ini: fonnte
whatsapp.provider = fonnte
whatsapp.fonnteEndpoint = https://api.fonnte.com/send
whatsapp.fonnteToken = PDmW4WZkmvWmKbq2sPUg
whatsapp.timeout = 20

# Fallback mapping nama ke nomor WA (pakai jika tabel users belum punya kolom nomor)
# Format: NAMA:62812...,NAMA LAIN:62813...
whatsapp.namePhoneMap =
